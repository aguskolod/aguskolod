---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import DaySection from '../components/DaySection.astro';
import MenuSection from '../components/MenuSection.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import MapSection from '../components/MapSection.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<BaseLayout>
  <Header />
  <main id="contenido">
    <Hero />
    <DaySection />
    <MenuSection />
    <ReviewsSection />
    <MapSection />
  </main>
  <Footer />
</BaseLayout>

<script>
  import { initSiteInteractions } from '../scripts/site';
  initSiteInteractions();
</script>
