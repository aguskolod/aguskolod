<section class="section section-menu" id="menu">
  <div class="wrap menu-layout">
    <div class="menu-copy">
      <p class="eyebrow">Menú</p>
      <h2>Sabores que acompañan todo el día.</h2>
      <p class="lede">
        Cafetería, confitería y bistró con producción propia. La carta digital se publica acá cuando esté lista.
      </p>
      <a
        class="btn btn-primary"
        href="https://www.instagram.com/mesalcafe"
        target="_blank"
        rel="noopener noreferrer"
      >
        Ver en Instagram
      </a>
      <p class="menu-note">Mientras tanto, mirá la oferta del día en @mesalcafe.</p>
    </div>
    <figure class="menu-media">
      <img
        src="/assets/menu-food.jpg"
        alt="Plato y bebida de Mesal Café"
        width="1200"
        height="900"
        loading="lazy"
      />
    </figure>
  </div>
</section>
