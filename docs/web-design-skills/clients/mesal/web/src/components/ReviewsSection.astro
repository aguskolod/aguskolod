---
const reviews = [
  {
    quote: 'Punto de encuentro cálido y cotidiano en el centro de Esquel.',
    source: 'Posicionamiento · prensa local',
  },
  {
    quote: 'Se siente ciudad grande — y por la ventana, la montaña.',
    source: 'VoC · Red43',
  },
  {
    quote: 'Para venir varias veces por semana, accesible al vecino.',
    source: 'VoC · Red43',
  },
];
---

<section class="section section-reviews" id="resenas">
  <div class="wrap">
    <p class="eyebrow">Reseñas</p>
    <h2>Lo que dicen en Google.</h2>
    <p class="lede proof-score"><strong>4,9★</strong> · 281 reseñas</p>

    <div class="reviews-slider" data-slider>
      <div class="reviews-track" data-track>
        {
          reviews.map((r) => (
            <blockquote class="review-card">
              <p>{r.quote}</p>
              <footer>{r.source}</footer>
            </blockquote>
          ))
        }
      </div>
      <div class="reviews-controls">
        <button type="button" class="btn btn-secondary btn-sm" data-prev aria-label="Reseña anterior">
          ←
        </button>
        <button type="button" class="btn btn-secondary btn-sm" data-next aria-label="Reseña siguiente">
          →
        </button>
        <a
          class="text-link"
          href="https://maps.app.goo.gl/Gbn8euUCuPqtYvEeA"
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver en Google Maps
        </a>
      </div>
    </div>
  </div>
</section>
