---
---

<section class="hero" id="inicio" aria-label="Inicio">
  <div class="hero-media" aria-hidden="true">
    <img src="/assets/hero.jpg" alt="" width="1600" height="1066" />
  </div>
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="wrap hero-content">
    <div class="hero-brand">
      <div class="hero-brand-frost" aria-hidden="true"></div>
      <div class="hero-logo-glow" aria-hidden="true"></div>
      <img
        class="hero-logo"
        src="/assets/logo-light.png"
        alt="Mesal Café y Bistró"
        width="360"
        height="306"
      />
    </div>
    <h1 class="hero-title">Café &amp; bistró de todo el día.</h1>
    <p class="hero-hours">08:00 – 00:00</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="#menu">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h10"></path>
        </svg>
        Menú
      </a>
      <a
        class="btn btn-secondary btn-on-dark"
        href="https://maps.app.goo.gl/Gbn8euUCuPqtYvEeA"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 21s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10z"></path>
          <circle cx="12" cy="11" r="2.2"></circle>
        </svg>
        Cómo llegar
      </a>
    </div>
    <ul class="amenities" aria-label="Características">
      <li>
        <span class="amenity-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21V8"></path>
            <path d="M12 8c-2.2-1.2-3.5-3-3.5-5 1.8.4 3.2 1.6 3.5 3.2C12.3 4.6 13.7 3.4 15.5 3c0 2-1.3 3.8-3.5 5z"></path>
            <path d="M12 12c-2.5-.3-4.5-1.6-5.5-3.5 2 .2 3.8 1.1 5.5 2.6 1.7-1.5 3.5-2.4 5.5-2.6-1 1.9-3 3.2-5.5 3.5z"></path>
            <path d="M12 16c-2.5-.3-4.8-1.4-6-3.2 2.2.1 4.2.9 6 2.4 1.8-1.5 3.8-2.3 6-2.4-1.2 1.8-3.5 2.9-6 3.2z"></path>
            <path d="M5 19L19 5"></path>
          </svg>
        </span>
        <span>Sin TACC</span>
      </li>
      <li>
        <span class="amenity-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
            <circle cx="6.5" cy="9" r="2.1"></circle>
            <circle cx="17.5" cy="9" r="2.1"></circle>
            <circle cx="4.8" cy="14" r="1.9"></circle>
            <circle cx="19.2" cy="14" r="1.9"></circle>
            <path d="M12 13.2c-2.85 0-5.15 1.55-5.15 3.55 0 1.35 1.15 2.05 2.35 2.05.85 0 1.55-.35 2.8-.35s1.95.35 2.8.35c1.2 0 2.35-.7 2.35-2.05 0-2-2.3-3.55-5.15-3.55z"></path>
          </svg>
        </span>
        <span>Pet friendly</span>
      </li>
      <li>
        <span class="amenity-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="5" width="16" height="11" rx="1.2"></rect>
            <path d="M2 18h20"></path>
            <path d="M9 18v1h6v-1"></path>
          </svg>
        </span>
        <span>Cowork</span>
      </li>
    </ul>
  </div>
</section>
