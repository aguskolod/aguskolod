---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mesal Café · Café & bistró de todo el día | Esquel',
  description = 'Mesal Café en Av. Fontana 769, Esquel. Café & bistró de todo el día, elaboración propia. Abierto 08:00–00:00. Sin TACC, pet friendly.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
